# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union

# ADMX/ADML: store blob bytes as-is so all delivery paths (git archive,
# clone autocrlf=false, clone autocrlf=true) reproduce the exact MD5
# recorded in config/tiermodel-admx.json and config/tiermodel-adml-en-US.json.
*.admx binary
*.adml binary
