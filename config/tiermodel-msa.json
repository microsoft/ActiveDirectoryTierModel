{
  "version": "1.0.0",
  "comment": "MSA (Managed Service Account) ACL delegations for Tier Model. Optional add-on — loaded only when -IncludeMsa is specified.",
  "managedServiceAccountType": "MSA",
  "aclDelegations": [
    {
      "targetOUPath": "OU=Tier 1 Service Accounts,OU=Tier 1,OU=Tier Model Administration,{{DOMAIN_DN}}",
      "identityreference": "Tier1Admins",
      "activedirectoryrights": [
        "CreateChild",
        "DeleteChild"
      ],
      "accesscontroltype": "Allow",
      "objecttype": "msDS-ManagedServiceAccount",
      "activeDirectorysecurityinheritance": "All",
      "resolveguid": true,
      "tier": 1,
      "comment": "Grant Tier1Admins create and delete over MSA objects in Tier 1 Service Accounts"
    },
    {
      "targetOUPath": "OU=Tier 1 Service Accounts,OU=Tier 1,OU=Tier Model Administration,{{DOMAIN_DN}}",
      "identityreference": "Tier1Admins",
      "activedirectoryrights": [
        "GenericAll"
      ],
      "accesscontroltype": "Allow",
      "objecttype": "AllObjectClasses",
      "activeDirectorysecurityinheritance": "Descendents",
      "inheritedObjectType": "msDS-ManagedServiceAccount",
      "resolveguid": true,
      "tier": 1,
      "comment": "Grant Tier1Admins GenericAll on descendant MSA objects in Tier 1 Service Accounts"
    },
    {
      "targetOUPath": "OU=Tier 2 Service Accounts,OU=Tier 2,OU=Tier Model Administration,{{DOMAIN_DN}}",
      "identityreference": "Tier2Admins",
      "activedirectoryrights": [
        "CreateChild",
        "DeleteChild"
      ],
      "accesscontroltype": "Allow",
      "objecttype": "msDS-ManagedServiceAccount",
      "activeDirectorysecurityinheritance": "All",
      "resolveguid": true,
      "tier": 2,
      "comment": "Grant Tier2Admins create and delete over MSA objects in Tier 2 Service Accounts"
    },
    {
      "targetOUPath": "OU=Tier 2 Service Accounts,OU=Tier 2,OU=Tier Model Administration,{{DOMAIN_DN}}",
      "identityreference": "Tier2Admins",
      "activedirectoryrights": [
        "GenericAll"
      ],
      "accesscontroltype": "Allow",
      "objecttype": "AllObjectClasses",
      "activeDirectorysecurityinheritance": "Descendents",
      "inheritedObjectType": "msDS-ManagedServiceAccount",
      "resolveguid": true,
      "tier": 2,
      "comment": "Grant Tier2Admins GenericAll on descendant MSA objects in Tier 2 Service Accounts"
    }
  ]
}
