{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/tiermodel.schema.json",
  "title": "Tier Model Configuration",
  "type": "object",
  "required": ["version", "organizationUnits", "groups", "users", "gpos"],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "preferredDc": {"type": "string"},
    "metadata": {
      "type": "object",
      "properties": {
        "generated": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "organizationUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "protectFromAccidentalDeletion": {"type": "boolean"},
          "disableInheritance": {"type": "boolean"},
          "blockGpoInheritance": {"type": "boolean"},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "scope"],
        "properties": {
          "name": {"type": "string"},
          "scope": {"type": "string", "enum": ["DomainLocal", "Global", "Universal"]},
          "members": {"type": "array", "items": {"type": "string"}},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["samAccountName", "ouPath"],
        "properties": {
          "samAccountName": {"type": "string"},
          "displayName": {"type": "string"},
          "ouPath": {"type": "string"},
          "email": {"type": "string"},
          "enabled": {"type": "boolean"},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "gpos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "mode": {"type": "string", "enum": ["Import", "Create"]},
          "guid": {"type": "string"},
          "importPath": {"type": "string"},
          "links": {"type": "array", "items": {"type": "string"}},
          "linkEnabled": {"type": "boolean"},
          "scope": {"type": "array", "items": {"type": "string"}},
          "denyApplyGroups": {"type": "array", "items": {"type": "string"}},
          "userRightsAssignments": {"type": "array", "items": {"type": "object", "required": ["right", "principals"], "properties": {"right": {"type": "string"}, "principals": {"type": "array", "items": {"type": "string"}}, "resolveSid": {"type": "boolean"}, "comment": {"type": "string"}}, "additionalProperties": false}},
          "restrictedGroups": {"type": "array", "items": {"type": "object", "required": ["groupName"], "properties": {"groupName": {"type": "string"}, "members": {"type": "array", "items": {"type": "string"}}, "resolveSid": {"type": "boolean"}, "comment": {"type": "string"}}, "additionalProperties": false}},
          "enabled": {"type": "boolean"},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "aclDelegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetPath", "principal", "rights"],
        "properties": {
          "targetPath": {"type": "string"},
          "principal": {"type": "string"},
          "rights": {"type": "array", "items": {"type": "string"}},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "admx": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fileName": {"type": "string"},
          "hash": {"type": "string"},
          "comment": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "msaAclDelegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetOUPath", "identityreference", "activedirectoryrights", "accesscontroltype", "objecttype", "activeDirectorysecurityinheritance"],
        "properties": {
          "targetOUPath": {"type": "string"},
          "identityreference": {"type": "string"},
          "activedirectoryrights": {"type": "array", "items": {"type": "string"}},
          "accesscontroltype": {"type": "string"},
          "objecttype": {"type": "string"},
          "activeDirectorysecurityinheritance": {"type": "string"},
          "inheritedObjectType": {"type": "string"},
          "resolveguid": {"type": "boolean"},
          "tier": {"type": "integer"},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "gmsaAclDelegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetOUPath", "identityreference", "activedirectoryrights", "accesscontroltype", "objecttype", "activeDirectorysecurityinheritance"],
        "properties": {
          "targetOUPath": {"type": "string"},
          "identityreference": {"type": "string"},
          "activedirectoryrights": {"type": "array", "items": {"type": "string"}},
          "accesscontroltype": {"type": "string"},
          "objecttype": {"type": "string"},
          "activeDirectorysecurityinheritance": {"type": "string"},
          "inheritedObjectType": {"type": "string"},
          "resolveguid": {"type": "boolean"},
          "tier": {"type": "integer"},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "dmsaAclDelegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetOUPath", "identityreference", "activedirectoryrights", "accesscontroltype", "objecttype", "activeDirectorysecurityinheritance"],
        "properties": {
          "targetOUPath": {"type": "string"},
          "identityreference": {"type": "string"},
          "activedirectoryrights": {"type": "array", "items": {"type": "string"}},
          "accesscontroltype": {"type": "string"},
          "objecttype": {"type": "string"},
          "activeDirectorysecurityinheritance": {"type": "string"},
          "inheritedObjectType": {"type": "string"},
          "resolveguid": {"type": "boolean"},
          "tier": {"type": "integer"},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "winLapsDelegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ouDn", "computerSelfPermission", "readGroup", "resetGroup"],
        "properties": {
          "ouDn": {"type": "string"},
          "computerSelfPermission": {"type": "boolean"},
          "readGroup": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}, "minItems": 1}
            ]
          },
          "resetGroup": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}, "minItems": 1}
            ]
          },
          "isDomainControllerOu": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "domainAuditRule": {
      "type": "object",
      "description": "Domain-root SACL audit rule for Sentinel monitoring. Applies a single canonical audit ACE to the domain root DN.",
      "required": ["targetDn", "trusteeSid", "auditFlag", "inheritance", "rights"],
      "properties": {
        "comment": {"type": "string"},
        "targetDn": {"type": "string"},
        "trusteeSid": {"type": "string"},
        "auditFlag": {"type": "string", "enum": ["Success", "Failure", "Success, Failure"]},
        "inheritance": {"type": "string"},
        "rights": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
