{
  "schemaVersion": "1.0.0",
  "comment": "Windows LAPS DACL delegations for Tier Model. Optional add-on — loaded only when -IncludeWinLaps is specified.",
  "winLapsDelegations": [
    {
      "ouDn": "OU=Domain Controllers,{{DOMAIN_DN}}",
