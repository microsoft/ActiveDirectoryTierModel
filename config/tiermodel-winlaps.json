{
  "schemaVersion": "1.1.0",
  "comment": "Windows LAPS DACL delegations + GPO decryptor configuration for Tier Model. Optional add-on — loaded only when -IncludeWinLaps is specified.",
  "winLapsDelegations": [
    {
      "ouDn": "OU=Domain Controllers,{{DOMAIN_DN}}",
      "computerSelfPermission": true,
      "readGroup": "Domain Admins",
      "resetGroup": "Domain Admins",
      "isDomainControllerOu": true,
      "comment": "DSRM decryptor always defaults to Domain Admins (MS specification) — no decryptorGroup needed."
    },
    {
      "ouDn": "OU=Tier 0 Member Servers,{{DOMAIN_DN}}",
      "computerSelfPermission": true,
      "readGroup": "Tier 0 Server Operators",
      "resetGroup": "Tier 0 Server Operators",
      "decryptorGroup": "Tier 0 Server Operators",
      "decryptorGpoName": "*- Tier 0 Servers Windows LAPS - Computer"
    },
    {
      "ouDn": "OU=Tier Model Administration,{{DOMAIN_DN}}",
      "computerSelfPermission": true,
      "readGroup": "Tier 0 Admins",
      "resetGroup": "Tier 0 Admins",
      "decryptorGroup": "Tier 0 Admins",
      "decryptorGpoName": "*- Tier 0 PAWs Windows LAPS - Computer",
      "comment": "ACL is on root OU for inheritance; decryptor GPO targets PAW Devices OU specifically."
    },
    {
      "ouDn": "OU=Tier 1 Member Servers,{{DOMAIN_DN}}",
      "computerSelfPermission": true,
      "readGroup": "Tier 1 Server Operators",
      "resetGroup": "Tier 1 Server Operators",
      "decryptorGroup": "Tier 1 Server Operators",
      "decryptorGpoName": "*- Tier 1 Servers Windows LAPS - Computer"
    },
    {
      "ouDn": "OU=Tier 1 PAW Devices,OU=Tier 1,OU=Tier Model Administration,{{DOMAIN_DN}}",
      "computerSelfPermission": true,
      "readGroup": "Tier 1 Admins",
      "resetGroup": "Tier 1 Admins",
      "decryptorGroup": "Tier 1 Admins",
      "decryptorGpoName": "*- Tier 1 PAWs Windows LAPS - Computer"
    },
    {
      "ouDn": "OU=Tier 2 PAW Devices,OU=Tier 2,OU=Tier Model Administration,{{DOMAIN_DN}}",
      "computerSelfPermission": true,
      "readGroup": "Tier 2 Admins",
      "resetGroup": "Tier 2 Admins",
      "decryptorGroup": "Tier 2 Admins",
      "decryptorGpoName": "*- Tier 2 PAWs Windows LAPS - Computer"
    },
    {
      "ouDn": "OU=Tier 2 End-User Devices,{{DOMAIN_DN}}",
      "computerSelfPermission": true,
      "readGroup": "Tier 2 Device Operators",
      "resetGroup": "Tier 2 Device Operators",
      "decryptorGroup": "Tier 2 Device Operators",
      "decryptorGpoName": "*- Tier 2 EUD Windows LAPS - Computer"
    }
  ]
}
