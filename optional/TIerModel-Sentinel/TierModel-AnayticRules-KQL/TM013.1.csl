//Analytic Rule = PROD (TM013.1) - OU - Block Inheritance was Enabled on an OU
//Automation Rule = PROD (TM000) - TAGGING - Tier Model Incidents
SecurityEvent 
| where EventID == 5136
    and Activity has "modified" 
    and EventData has '"ObjectClass">site'
    and EventData has '<Data Name="AttributeLDAPDisplayName">gPOptions</Data>'
    and EventData has '"OperationType">%%14674'
    and EventData has 'AttributeValue">1'
| extend ObjectName = extract("<Data Name=\"ObjectDN\">((?i)OU=[^,]+(,(?i)OU=[^,]+)*),(?i)DC=", 1, EventData)
| extend AttributeLDAP = extract("<Data Name=\"AttributeLDAPDisplayName\">([^<]+)</Data>", 1, EventData)
| extend AttributeValue = extract("<Data Name=\"AttributeValue\">([0-9]+)</Data>", 1, EventData)
| extend AttributeValueDescription = case(
    AttributeValue == "1", "Block Inheritance",
    "Unknown")
| where AttributeValueDescription == "Block Inheritance"
| extend ObjectClass = extract("<Data Name=\"ObjectClass\">([^<]+)</Data>", 1, EventData)
| extend Domain = extract("([^.]+\\.[^.]+)$", 1, Computer)
| project TimeGenerated
   , ObjectName
   , ObjectClass
   , ActivityType = AttributeValueDescription
   , AttributeLDAP
   , Account
   , Domain
   , Computer
   , Channel
   , EventID
   , EventData